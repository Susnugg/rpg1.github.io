<script>
    let messages = [];
    let aiBase64 = null;
    let userBase64 = null;

    function bindImage(elementId, callback) {
        document.getElementById(elementId).addEventListener('change', function(e) {
            const file = e.target.files[0];
            const reader = new FileReader();
            reader.onload = function() { callback(reader.result); };
            if(file) reader.readAsDataURL(file);
        });
    }

    bindImage('ai-image', (res) => aiBase64 = res);
    bindImage('user-image', (res) => userBase64 = res);

    async function initChat() {
        const key = document.getElementById('api-key').value;
        if (!key) return alert("API Key required.");
        localStorage.setItem('groq_key', key);

        // System instructions
        messages = [{
            role: "system",
            content: `You are in a roleplay. AI: ${document.getElementById('ai-desc').value}. USER: ${document.getElementById('user-desc').value}.`
        }];

        // The Vision Model needs the images in a specific "user" message format
        if (aiBase64 || userBase64) {
            let contentArr = [{ type: "text", text: "Visual references for the characters:" }];
            
            if (aiBase64) {
                contentArr.push({ type: "text", text: "This is your (the AI) appearance:" });
                contentArr.push({ type: "image_url", image_url: { url: aiBase64 } });
            }
            if (userBase64) {
                contentArr.push({ type: "text", text: "This is my (the user) appearance:" });
                contentArr.push({ type: "image_url", image_url: { url: userBase64 } });
            }

            messages.push({ role: "user", content: contentArr });
        }

        document.getElementById('setup-screen').style.display = 'none';
        document.getElementById('output').style.display = 'flex';
        document.getElementById('input-area').style.display = 'flex';

        sendMessage("Wake up and introduce yourself based on your description and photo.");
    }

    async function sendMessage(textOverride) {
        const input = document.getElementById('user-input');
        const text = textOverride || input.value;
        if (!text) return;

        appendMsg(text, 'user-msg', 'YOU');
        if(!textOverride) input.value = "";

        messages.push({ role: "user", content: text });
        processAI();
    }

    async function processAI() {
        try {
            const res = await fetch("https://api.groq.com/openai/v1/chat/completions", {
                method: "POST",
                headers: { 
                    "Content-Type": "application/json", 
                    "Authorization": `Bearer ${localStorage.getItem('groq_key')}` 
                },
                body: JSON.stringify({ 
                    model: "llama-3.2-11b-vision-preview", 
                    messages: messages, 
                    temperature: 0.7,
                    max_tokens: 1024 // Vision models often require this set explicitly
                })
            });

            const data = await res.json();
            
            if (data.error) {
                console.error("Groq API Error:", data.error);
                appendMsg("API Error: " + data.error.message, 'ai-msg', 'SYSTEM');
                return;
            }

            const reply = data.choices[0].message.content;
            appendMsg(reply, 'ai-msg', 'CHARACTER');
            messages.push({ role: "assistant", content: reply });
        } catch (e) {
            console.error("Fetch Error:", e);
            appendMsg("Connection failed. Check your internet or API key.", 'ai-msg', 'SYSTEM');
        }
    }

    function appendMsg(text, cls, label) {
        const out = document.getElementById('output');
        const div = document.createElement('div');
        div.className = `msg ${cls}`;
        div.innerHTML = `<span class="msg-label">${label}</span>${text.replace(/\n/g, '<br>')}`;
        out.appendChild(div);
        out.scrollTop = out.scrollHeight;
    }
</script>
